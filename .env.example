API_PORT=8787
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b

# Opcional: caja de tráfico aéreo para el panel de vuelos (OpenSky, sin llave)
# formato: latmin,lonmin,latmax,lonmax — default: Europa occidental
# FLIGHTS_BBOX=36,-10,60,20

# Paneles con API key — el panel se muestra deshabilitado hasta que la agregues.
# ACLED: registro gratuito en https://acleddata.com/register/
# ACLED_API_KEY=
# ACLED_EMAIL=

# NASA FIRMS: MAP_KEY gratuita en https://firms.modaps.eosdis.nasa.gov/api/map_key/
# NASA_FIRMS_KEY=

# Cloudflare Radar: API token (permiso "Radar Read") en https://dash.cloudflare.com/profile/api-tokens
# CLOUDFLARE_RADAR_TOKEN=

# ThreatFox (abuse.ch): Auth-Key gratuita en https://auth.abuse.ch/
# THREATFOX_API_KEY=

# Alerts.in.ua (alertas aéreas Ucrania): token gratis vía Telegram https://t.me/alerts_in_ua_api_bot
# ALERTS_IN_UA_TOKEN=

# FRED (indicadores económicos EE.UU.): key gratuita en
# https://fred.stlouisfed.org/docs/api/api_key.html
# FRED_API_KEY=

# aisstream.io (tráfico marítimo AIS): key gratuita en https://aisstream.io/authenticate
# AISSTREAM_API_KEY=
# Opcional: caja del tráfico marítimo, formato latmin,lonmin,latmax,lonmax — default: Mediterráneo
# MARITIME_BBOX=30,-6,46,20

# YouTube Data API v3 (chequea qué canales de la pestaña TV están realmente en
# vivo y permiten embed, antes de mostrarlos): key gratuita en
# https://console.cloud.google.com/apis/credentials — habilitar "YouTube Data API v3"
# YOUTUBE_API_KEY=
